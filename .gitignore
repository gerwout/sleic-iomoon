# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Output directories from scripts
output/

# Per-frame DMD dump splits (regenerable with scripts/dmd_dump_split.py from
# the committed raw dump; only the per-scene repr.txt is committed)
dmd/**/screens/*/frame-*.txt

# Key script mark sidecars generated by a -key_script run (regenerable)
*.keys.marks

# Local gameplay capture videos (not for commit)
video/

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

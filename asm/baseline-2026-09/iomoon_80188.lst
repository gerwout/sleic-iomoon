    D0000:    FA                         CLI      
    D0001:    B8 52 41                   MOV      AX, 04152
    D0004:    8E D0                      MOV      SS, AX
    D0006:    B8 05 02                   MOV      AX, 00205
    D0009:    8B E0                      MOV      SP, AX
    D000B:    B8 00 40                   MOV      AX, 04000
    D000E:    8E D8                      MOV      DS, AX
    D0010:    8E C0                      MOV      ES, AX
    D0012:    BE 41 00                   MOV      SI, 00041
    D0015:    B9 1E 00                   MOV      CX, 0001E
    D0018:    2E AD                      LODSW    
    D001A:    8B D0                      MOV      DX, AX
    D001C:    2E AD                      LODSW    
    D001E:    EF                         OUT      DX, AX
    D001F:    E2 F7                      LOOP     0D0018
